venbos-kasteel-wolvenbos-tim-noens-zd"},{"k":"i","src":"Kasteel Wolvenbos - Jonathan Wiels - zd.JPG","c":"Kasteel Wolvenbos - Jonathan Wiels - z.d.","id":"kasteel-wolvenbos-kasteel-wolvenbos-jonathan-wiels-zd"},{"k":"i","src":"Kasteel Wolvenbos - Helena Demuynck 2 - zd.JPG","c":"Kasteel Wolvenbos - Helena Demuynck - z.d.","id":"kasteel-wolvenbos-kasteel-wolvenbos-helena-demuynck-2-zd"},{"k":"i","src":"Kasteel Wolvenbos - Fred Duyzer - zd.JPG","c":"Kasteel Wolvenbos - Fred Duijzer - z.d.","id":"kasteel-wolvenbos-kasteel-wolvenbos-fred-duyzer-zd"},{"k":"i","src":"Kasteel Wolvenbos - Jonathan Wiels 3 - zd.JPG","c":"Kasteel Wolvenbos - Jonathan Wiels - z.d.","id":"kasteel-wolvenbos-kasteel-wolvenbos-jonathan-wiels-3-zd"},{"k":"i","src":"Kasteel Wolvenbos - Maxim 2 - zd.JPG","c":"Kasteel Wolvenbos - Maxim - z.d.","id":"kasteel-wolvenbos-kasteel-wolvenbos-maxim-2-zd"}]},{"heading":"ORANGERIE, TUIN en MOESTUIN in DOMEIN WOLVENBOS","places":["kasteel-wolvenbos"],"parts":[{"k":"i","src":"Kasteel Wolvenbos - moestuin - Anse Klinsaer 2 - zd.JPG","c":"Kasteel Wolvenbos - moestuin - Anse Klinsaer - z.d.","id":"kasteel-wolvenbos-kasteel-wolvenbos-moestuin-anse-klinsaer-2-zd"},{"k":"i","src":"Kasteel Wolvenbos - Philippe Wuyts - zd.JPG","c":"Kasteel Wolvenbos - Philippe Wuyts - z.d.","id":"kasteel-wolvenbos-kasteel-wolvenbos-philippe-wuyts-zd"},{"k":"i","src":"Kasteel Wolvenbos - Nils Lambrichts - zd.JPG","c":"Kasteel Wolvenbos - Nils Lambrechts - z.d.","id":"kasteel-wolvenbos-kasteel-wolvenbos-nils-lambrichts-zd"},{"k":"i","src":"Kasteel Wolvenbos 1 - z.n. - zd.JPG","c":"Kasteel Wolvenbos - z.n. - z.d.","id":"kasteel-wolvenbos-kasteel-wolvenbos-1-z-n-zd"},{"k":"i","src":"Kasteel Wolvenbos - Orangerie - HH - zd.jpg","id":"kasteel-wolvenbos-kasteel-wolvenbos-orangerie-hh-zd"},{"k":"i","src":"Kasteel Wolvenbos - Orangerie 2 - HH - zd.JPG","c":"Kasteel Wolvenbos - Orangerie - Heemkring Hoghescote - z.d.","id":"kasteel-wolvenbos-kasteel-wolvenbos-orangerie-2-hh-zd"}]},{"heading":"DE P