{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "gazetteer:build": "npm run build && node lib/functions/scripts/build-gazetteer.js",
    "corpus:report": "npm run build && node lib/functions/scripts/corpus-report.js",
    "map:labels": "npm run build && node lib/functions/scripts/extract-map-labels.js",
    "archive:index": "npm run build && node lib/functions/scripts/build-archive-index.js",
    "stories": "npm run build && node lib/functions/scripts/build-stories.js",
    "streets": "npm run build && node lib/functions/scripts/build-street-geometry.js",
    "plaatsen": "npm run build && node lib/functions/scripts/build-place-approximations.js",
    "sitemap": "npm run build && node lib/functions/scripts/build-sitemap.js",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "test": "jest",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "compile": "tsc",
    "debug": "node --inspect node_modules/.bin/functions-framework --source=lib/functions/src/ --target=index",
    "watch": "concurrently \"npm run compile -- --watch\" \"nodemon --watch ./lib/ --exec npm run debug\""
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/functions/src/index.js",
  "dependencies": {
    "@google-cloud/firestore": "^7.9.0",
    "@google-cloud/storage": "^7.12.1",
    "busboy": "^1.6.0",
    "firebase-admin": "^12.1.0",
    "firebase-functions": "^5.1.1",
    "functions-framework": "^0.6.10",
    "swagger-jsdoc": "^6.2.8"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/jest": "^29.5.12",
    "concurrently": "^8.2.0",
    "firebase-functions-test": "^3.1.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "ts-jest": "^29.2.5",
    "typescript": "^4.9.0"
  },
  "private": true
}
